# ==========================================
# StockAgent 环境配置示例
# 
# 使用方法:
#   1. 复制此文件为 .env
#   2. 根据实际情况修改配置值
#   3. 敏感信息请勿提交到版本控制
# ==========================================

# ==================== 基础配置 ====================

DEBUG=false
JWT_SECRET=qibaliliStockAgentServerKey
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==================== 节点配置 ====================

# 节点类型: web, data_sync, mcp, inference
NODE_TYPE=web
# 节点 ID (可选，不填则自动生成)
# NODE_ID=web-node-1
NODE_HEARTBEAT_INTERVAL=10
NODE_TTL=30

# ==================== Web 服务配置 ====================de

WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_WORKERS=1
WEB_RELOAD=false
STRATEGY_V2_MAX_CONCURRENT_RUNS=1
STRATEGY_V2_ONE_LINE_CACHE_MAX_ENTRIES=64
STRATEGY_V2_ONE_LINE_CACHE_MAX_TTL_DAYS=2

# ==================== Redis 配置 ====================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=5201314a
REDIS_DB=0
REDIS_MAX_CONNECTIONS=30
REDIS_MAX_TASK_QUEUE_LENGTH=1000

# 队列配置 (通常无需修改)
REDIS_TASK_QUEUE=agent:tasks
REDIS_RESULT_CHANNEL_PREFIX=agent:results
REDIS_NODE_REGISTRY_PREFIX=agent:nodes

# ==================== MongoDB 配置 ====================

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USERNAME=admin
MONGO_PASSWORD=5201314a
MONGO_DATABASE=stock_agent
MONGO_AUTH_SOURCE=admin
MONGO_MAX_POOL_SIZE=20
MONGO_INSERT_MANY_BATCH_SIZE=1000
MONGO_ENSURE_INDEXES=true
MONGO_INDEX_CREATE_TIMEOUT_SECONDS=30
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=5000
MONGO_AGGREGATE_DEFAULT_LIMIT=10000
MONGO_AGGREGATE_BATCH_SIZE=1000
MONGO_AGGREGATE_MAX_TIME_MS=30000

# ==================== Milvus 向量数据库配置 ====================

MILVUS_HOST=localhost
MILVUS_PORT=19530
# MILVUS_USER=root
# MILVUS_PASSWORD=your-milvus-password
MILVUS_RESEARCH_REPORTS_COLLECTION=research_reports
MILVUS_MARKET_SNIPPETS_COLLECTION=market_snippets
MILVUS_EMBEDDING_DIM=1024

# ==================== Tushare 数据源配置 ====================

# 必须! 请在 https://tushare.pro 注册获取 Token
TUSHARE_TOKEN=YOUR_TOKEN
TUSHARE_RATE_LIMIT=200
TUSHARE_BATCH_SIZE=100

# ==================== Coze 工作流数据源配置 ====================

# Coze PAT / API Token
COZE_API_TOKEN=YOUR_COZE_PAT

# 统一股票工作流
COZE_API_BASE=https://api.coze.cn
COZE_WORKFLOW_ID=7635993821533487155
COZE_SPACE_ID=7492401860964810793
COZE_MARKET_INDICATOR_WORKFLOW_ID=7587701552685629494
COZE_STOCK_PICKER_WORKFLOW_ID=7579577947649277987

# 可选：部分工作流可能要求 app_id / bot_id
# COZE_APP_ID=
# COZE_BOT_ID=

# 请求超时（秒）
COZE_TIMEOUT=30

# ==================== LLM 模型配置 ====================

# 模型提供商: openai, dashscope (阿里), zhipu, ollama
LLM_PROVIDER=deepseek

# 阿里云 DashScope (推荐国内使用)
LLM_API_KEY=YOUR_API_KEY
LLM_MODEL_NAME=deepseek-chat
LLM_EMBEDDING_MODEL=text-embedding-v3

# OpenAI (如果使用)
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your-openai-api-key
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o
# LLM_EMBEDDING_MODEL=text-embedding-3-small

# Ollama 本地模型 (如果使用)
# LLM_PROVIDER=ollama
# LLM_API_BASE=http://localhost:11434
# LLM_MODEL_NAME=qwen2.5:14b

# 模型参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_MAX_CONCURRENT_REQUESTS=3

# ==================== 数据同步配置 ====================

# 运行档位:
# conservative=服务器保守默认，只注册核心行情/市场统计链路
# full=注册全部内置任务
# custom=仅注册 SYNC_ENABLED_JOBS 指定任务
SYNC_PROFILE=conservative

# 逗号分隔任务名；白名单存在时优先于档位，黑名单可剔除某些任务
# SYNC_ENABLED_JOBS=stock_daily,index_daily,limit_list,daily_stats
# SYNC_DISABLED_JOBS=stock_news,hot_news,ths_sector

# 服务器默认不在节点启动时立即同步，避免 DEBUG=true 时全任务启动风暴
SYNC_RUN_INITIAL_SYNC=false

# DataSync 常驻进程保护
SYNC_MAX_RUNNING_JOBS=1
SYNC_MAX_PARALLEL_COLLECT_CONCURRENCY=2
SYNC_JOB_TIMEOUT_SECONDS=1200
SYNC_LOCK_TIMEOUT_SECONDS=1200
SYNC_SCHEDULER_MISFIRE_GRACE_SECONDS=300

# 首次运行保护：默认禁止自动全历史回补，只补最近交易日或少量窗口
SYNC_PREVENT_INITIAL_HISTORY_SYNC=true
SYNC_INITIAL_BACKFILL_DAYS=5

# 采集调度时间 (cron 表达式: 分 时 日 月 周)
# 不填则使用默认值

# 股票基础信息采集 (默认: 每个交易日 18:00)
SYNC_STOCK_BASIC_SCHEDULE=0 18 * * 1-5

# 日线数据采集 (默认: 每个交易日 18:05)
SYNC_STOCK_DAILY_SCHEDULE=5 18 * * 1-5

# 仅同步重点股票（自选股 + 监听股），适合 Coze 单股模式
SYNC_FOCUS_STOCKS_ONLY=false

# 重点股票最大数量（去重后截断）
SYNC_FOCUS_STOCKS_MAX_COUNT=200

# 新闻采集 (默认: 每 2 小时)
SYNC_NEWS_SCHEDULE=0 */2 * * *

# 指数基础信息采集 (默认: 每个交易日 18:05)
SYNC_INDEX_BASIC_SCHEDULE=5 18 * * 1-5

# 指数日线数据采集 (默认: 每个交易日 18:05)
SYNC_INDEX_DAILY_SCHEDULE=5 18 * * 1-5

# 行业资金流向采集 (默认: 每个交易日 18:05)
SYNC_MONEYFLOW_INDUSTRY_SCHEDULE=5 18 * * 1-5

# 概念板块资金流向采集 (默认: 每个交易日 18:05)
SYNC_MONEYFLOW_CONCEPT_SCHEDULE=5 18 * * 1-5

# 涨跌停数据采集 (默认: 每个交易日 18:05)
SYNC_LIMIT_LIST_SCHEDULE=5 18 * * 1-5

# 每日统计数据计算 (默认: 每个交易日 18:10，确保其他数据已同步)
SYNC_DAILY_STATS_SCHEDULE=10 18 * * 1-5

# 市场统计缓存预聚合 (默认: 每个交易日 18:20)
SYNC_MARKET_STATISTICS_CACHE_SCHEDULE=20 18 * * 1-5

# 市场晴雨表 (默认: 每个交易日 18:40)
SYNC_MARKET_WEATHER_SCHEDULE=40 18 * * 1-5
SYNC_MARKET_WEATHER_MAX_CONCURRENT=2

# 全量档位下的新闻/事件任务削峰配置
SYNC_HOT_NEWS_MAX_CONCURRENCY=3
SYNC_EVENT_CLUSTERING_BATCH_SIZE=30
SYNC_EVENT_CLUSTERING_MAX_CONCURRENT=3

# 每日复盘数据采集 (默认: 每个交易日 18:05，收盘后数据稳定)
SYNC_REVIEW_DATA_SCHEDULE=5 18 * * 1-5
SYNC_REVIEW_DATA_MAX_ROWS_PER_COLLECTION=10000

# 同花顺板块数据采集 (默认: 每周六凌晨 2:00，板块变化频率低)
SYNC_THS_SECTOR_SCHEDULE=0 2 * * 6

# 股票关联关系构建 (默认: 每个交易日 16:20，依赖 stock_basic / ths_sector / limit_list)
SYNC_STOCK_RELATIONS_SCHEDULE=20 16 * * 1-5

# 新闻采集 (默认: 每 2 小时)
# SYNC_NEWS_SCHEDULE=0 */2 * * *

# ==================== 可观测性配置 ====================

# 日志级别: DEBUG, INFO, WARNING, ERROR
OBS_LOG_LEVEL=INFO

# 日志文件配置
OBS_LOG_TO_FILE=true
OBS_LOG_DIR=logs
OBS_LOG_MAX_SIZE_MB=50
OBS_LOG_BACKUP_COUNT=10

# Loki 日志收集 (可选)
OBS_LOKI_ENABLED=false
# OBS_LOKI_URL=http://localhost:3100/loki/api/v1/push

# Arize Phoenix 追踪 (可选)
OBS_PHOENIX_ENABLED=false
OBS_PHOENIX_PROJECT=stock-agent

# ==================== Listener 节点配置 ====================

# 轮询间隔 (秒)
LISTENER_POLL_INTERVAL=60
LISTENER_POLL_TIMEOUT_SECONDS=180

# 每日涨跌停数据获取时间 (格式: HH:MM)
LISTENER_LIMIT_FETCH_TIME=09:00

# 交易时间配置 (格式: HH:MM-HH:MM)
LISTENER_MORNING_SESSION=09:30-11:30
LISTENER_AFTERNOON_SESSION=13:00-15:00

# 非交易时间是否静默
LISTENER_SILENT_OUTSIDE_TRADING=true

# 大股票列表监听分批参数
LISTENER_LARGE_WATCH_BATCH=400
LISTENER_LARGE_WATCH_THRESHOLD=600

# ==================== 通知配置 ====================

# 企业微信 Webhook URL
# 获取方式: 企业微信 -> 群设置 -> 群机器人 -> 添加 -> 复制 Webhook 地址
NOTIFY_WECOM_WEBHOOK=YOU_WECOM_WEBHOOK

# 是否启用通知
NOTIFY_ENABLED=true

# 消息发送最小间隔 (秒，防止刷屏)
NOTIFY_MIN_INTERVAL=10

# ==================== RPC 配置 ====================

# 各节点 gRPC 端口
RPC_WEB_PORT=50051
RPC_INFERENCE_PORT=50052
RPC_LISTENER_PORT=50053
RPC_DATA_SYNC_PORT=50054
RPC_MCP_PORT=50055

# RPC 超时 (秒)
RPC_TIMEOUT=10.0

# RPC 重试次数
RPC_MAX_RETRIES=3

# ============ Embedding 单独配置 ============
# 因为 DeepSeek 不支持 Embedding API，使用 DashScope

# Embedding Provider (openai/dashscope/zhipu/ollama)
LLM_EMBEDDING_PROVIDER=zhipu

# DashScope API Key (阿里云)
LLM_EMBEDDING_API_KEY=YOU_API_KEY

# Embedding 模型 (DashScope 的 text-embedding-v3)
LLM_EMBEDDING_MODEL=embedding-2
