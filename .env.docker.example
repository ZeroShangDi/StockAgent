# ==========================================
# StockAgent Docker Compose 环境配置示例
# 使用方式：
#   cp .env.docker.example .env.docker
#   然后按需修改下面的配置
# 
# 必配项清单（首次部署至少改这些）：
#   1. JWT_SECRET
#   2. MONGO_PASSWORD
#   3. MONGO_INITDB_ROOT_PASSWORD
#   4. TUSHARE_TOKEN
#   5. LLM_API_KEY
#
# 可选项：
#   - COZE_API_TOKEN：只在启用 Coze 工作流时需要
#   - NOTIFY_WECOM_WEBHOOK：只在启用企业微信通知时需要
# ==========================================

# ==================== Compose 端口映射 ====================
FRONTEND_PORT=80
BACKEND_PORT=8000
MONGO_PORT=27017
REDIS_PORT=6379
MILVUS_PORT=19530
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ==================== 镜像源 / 构建加速 ====================
# 默认使用更适合国内网络的镜像与包源；如果你的环境访问官方源更快，可改回官方地址。
MONGO_IMAGE=docker.m.daocloud.io/mongo:7.0
REDIS_IMAGE=docker.m.daocloud.io/redis:7.2-alpine
ETCD_IMAGE=docker.m.daocloud.io/quay.io/coreos/etcd:v3.5.5
MINIO_IMAGE=docker.m.daocloud.io/minio/minio:RELEASE.2024-01-16T16-07-38Z
MILVUS_IMAGE=docker.m.daocloud.io/milvusdb/milvus:v2.4.0
PYTHON_BASE_IMAGE=docker.m.daocloud.io/python:3.11-slim
NODE_BASE_IMAGE=docker.m.daocloud.io/node:20-alpine
NGINX_BASE_IMAGE=docker.m.daocloud.io/nginx:1.27-alpine
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
NPM_REGISTRY=https://registry.npmmirror.com

# ==================== 应用基础配置 ====================
DEBUG=false
JWT_SECRET=please-change-this-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==================== 节点 / Web ====================
NODE_HEARTBEAT_INTERVAL=10
NODE_TTL=30
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_WORKERS=1
WEB_RELOAD=false
MAX_CONCURRENT_TASKS=5
DATA_SYNC_CPUS=0.75
DATA_SYNC_MEM_LIMIT=512m

# ==================== Redis ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=100

# ==================== MongoDB ====================
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_USERNAME=admin
MONGO_PASSWORD=change-me
MONGO_DATABASE=stock_agent
MONGO_AUTH_SOURCE=admin
MONGO_MAX_POOL_SIZE=50
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_INITDB_DATABASE=stock_agent

# ==================== Milvus / MinIO ====================
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_RESEARCH_REPORTS_COLLECTION=research_reports
MILVUS_MARKET_SNIPPETS_COLLECTION=market_snippets
MILVUS_EMBEDDING_DIM=1024
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ==================== 数据源 ====================
# 必填：Tushare 行情与财务数据依赖此 Token。
# 不配置将导致股票基础数据、日线、资金流、部分回测/分析功能不可用。
TUSHARE_TOKEN=YOUR_TUSHARE_TOKEN
TUSHARE_RATE_LIMIT=200
TUSHARE_BATCH_SIZE=100

# ==================== 数据同步 ====================
# 服务器默认使用保守档，避免 DataSync 全量历史回补和高并发任务拖垮机器。
SYNC_PROFILE=conservative
SYNC_RUN_INITIAL_SYNC=false
SYNC_MAX_RUNNING_JOBS=1
SYNC_MAX_PARALLEL_COLLECT_CONCURRENCY=2
SYNC_JOB_TIMEOUT_SECONDS=1200
SYNC_LOCK_TIMEOUT_SECONDS=1200
SYNC_SCHEDULER_MISFIRE_GRACE_SECONDS=300
SYNC_PREVENT_INITIAL_HISTORY_SYNC=true
SYNC_INITIAL_BACKFILL_DAYS=5

# 保守档默认会注册这些核心任务：
# stock_basic, stock_daily, index_basic, index_daily, moneyflow_industry,
# moneyflow_concept, limit_list, review_data, daily_stats,
# market_statistics_cache, market_weather
# 如需临时覆盖：
# SYNC_ENABLED_JOBS=stock_daily,index_daily,limit_list,daily_stats
# SYNC_DISABLED_JOBS=review_data,market_weather

# 核心任务调度建议错峰，避免同一分钟集中抢 CPU/内存。
SYNC_STOCK_BASIC_SCHEDULE=0 18 * * 1-5
SYNC_STOCK_DAILY_SCHEDULE=5 18 * * 1-5
SYNC_INDEX_BASIC_SCHEDULE=12 18 * * 1-5
SYNC_INDEX_DAILY_SCHEDULE=14 18 * * 1-5
SYNC_MONEYFLOW_INDUSTRY_SCHEDULE=18 18 * * 1-5
SYNC_MONEYFLOW_CONCEPT_SCHEDULE=22 18 * * 1-5
SYNC_LIMIT_LIST_SCHEDULE=26 18 * * 1-5
SYNC_REVIEW_DATA_SCHEDULE=32 18 * * 1-5
SYNC_DAILY_STATS_SCHEDULE=38 18 * * 1-5
SYNC_MARKET_STATISTICS_CACHE_SCHEDULE=44 18 * * 1-5
SYNC_MARKET_WEATHER_SCHEDULE=50 18 * * 1-5

# ==================== Coze ====================
# 可选：仅当你使用 Coze 工作流能力时需要配置。
# 不配置不会影响基础 Web、登录、普通页面访问，但相关 Coze 分析能力会不可用。
COZE_API_TOKEN=
COZE_API_BASE=https://api.coze.cn
COZE_WORKFLOW_ID=7635993821533487155
COZE_SPACE_ID=7492401860964810793
COZE_MARKET_INDICATOR_WORKFLOW_ID=7587701552685629494
COZE_STOCK_PICKER_WORKFLOW_ID=7579577947649277987
COZE_TIMEOUT=30

# ==================== LLM ====================
# 必填：至少需要配置一组可用的大模型 Token/API Key。
# 不配置将导致 AI 分析、报告生成、向量检索增强等能力不可用。
# 如果使用 DeepSeek / OpenAI / DashScope / 智谱 / Ollama，请按你的 provider 填写对应字段。
LLM_PROVIDER=deepseek
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_API_BASE=
LLM_MODEL_NAME=deepseek-chat
LLM_EMBEDDING_MODEL=text-embedding-v3
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_MAX_CONCURRENT_REQUESTS=10

# ==================== 可观测性 ====================
OBS_LOG_LEVEL=INFO
OBS_LOG_TO_FILE=true
OBS_LOG_DIR=logs
OBS_LOG_MAX_SIZE_MB=50
OBS_LOG_BACKUP_COUNT=10
OBS_LOKI_ENABLED=false
OBS_PHOENIX_ENABLED=false
OBS_PHOENIX_PROJECT=stock-agent

# ==================== Listener ====================
LISTENER_POLL_INTERVAL=60
LISTENER_LIMIT_FETCH_TIME=09:00
LISTENER_MORNING_SESSION=09:30-11:30
LISTENER_AFTERNOON_SESSION=13:00-15:00
LISTENER_SILENT_OUTSIDE_TRADING=true

# ==================== 通知 ====================
NOTIFY_WECOM_WEBHOOK=
NOTIFY_ENABLED=false
NOTIFY_MIN_INTERVAL=10

# ==================== RPC ====================
RPC_WEB_PORT=50051
RPC_INFERENCE_PORT=50052
RPC_LISTENER_PORT=50053
RPC_DATA_SYNC_PORT=50054
RPC_MCP_PORT=50055
RPC_BACKTEST_PORT=50056
