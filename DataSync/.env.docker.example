# ==========================================
# Standalone DataSync Docker 环境配置示例
#
# 使用方法:
#   1. 复制此文件为 DataSync/.env.docker
#   2. 根据实际情况填入密钥
#   3. 使用 `docker compose --env-file .env.docker up --build`
# ==========================================

DEBUG=false

NODE_TYPE=data_sync
DATASYNC_RUNTIME_DIR=/app/DataSync
DATASYNC_DATA_DIR=/app/DataSync/data
DATASYNC_ALLOW_SHARED_ENV_FALLBACK=0
DATA_SYNC_CPUS=0.75
DATA_SYNC_MEM_LIMIT=512M

# Mongo/Redis 默认只绑定本机，避免数据库端口被公网访问。
# 应用容器内连接仍使用 MONGO_PORT/REDIS_PORT；如需改宿主机映射端口，请改 *_PUBLISHED_PORT。
REDIS_BIND_HOST=127.0.0.1
REDIS_PUBLISHED_PORT=6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=30

MONGO_BIND_HOST=127.0.0.1
MONGO_PUBLISHED_PORT=27017
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_USERNAME=admin
MONGO_PASSWORD=change-me
MONGO_DATABASE=stock_agent
MONGO_AUTH_SOURCE=admin
MONGO_MAX_POOL_SIZE=20
MONGO_ENSURE_INDEXES=true
MONGO_INDEX_STARTUP_SCOPE=core
MONGO_INDEX_CREATE_TIMEOUT_SECONDS=10

# Mongo 容器初始化账号；请保持与上方 DataSync 连接账号一致，避免初始化后连接失败。
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_INITDB_DATABASE=stock_agent

# 可选：第二目标 Mongo 镜像库（例如远程库）
MONGO_MIRROR_ENABLED=0
MONGO_MIRROR_HOST=remote-mongodb
MONGO_MIRROR_PORT=27017
MONGO_MIRROR_USERNAME=
MONGO_MIRROR_PASSWORD=
MONGO_MIRROR_DATABASE=stock_agent_remote
MONGO_MIRROR_AUTH_SOURCE=admin
MONGO_MIRROR_MAX_POOL_SIZE=20

MILVUS_URI=/app/DataSync/data/milvus_lite.db
MILVUS_RESEARCH_REPORTS_COLLECTION=research_reports
MILVUS_MARKET_SNIPPETS_COLLECTION=market_snippets
MILVUS_EMBEDDING_DIM=1024

TUSHARE_TOKEN=YOUR_TUSHARE_TOKEN
TUSHARE_RATE_LIMIT=200
TUSHARE_BATCH_SIZE=100

COZE_API_TOKEN=YOUR_COZE_PAT
COZE_API_BASE=https://api.coze.cn
COZE_WORKFLOW_ID=
COZE_SPACE_ID=
COZE_MARKET_INDICATOR_WORKFLOW_ID=
COZE_STOCK_PICKER_WORKFLOW_ID=
COZE_TIMEOUT=30
COZE_MAX_RETRIES=2
COZE_RETRY_BACKOFF_SECONDS=0.5
COZE_RETRY_BACKOFF_MAX_SECONDS=5

LLM_PROVIDER=deepseek
LLM_API_KEY=YOUR_API_KEY
LLM_API_BASE=
LLM_MODEL_NAME=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_MAX_CONCURRENT_REQUESTS=3

LLM_EMBEDDING_PROVIDER=dashscope
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_API_BASE=
LLM_EMBEDDING_MODEL=text-embedding-v3

SYNC_FOCUS_STOCKS_ONLY=false
SYNC_FOCUS_STOCKS_MAX_COUNT=200
SYNC_SOURCE_CHAIN_OVERRIDES=
SYNC_SOURCE_RATE_LIMITS=tushare=200/m,akshare=60/m,baostock=60/m,coze=30/m
SYNC_SOURCE_RATE_LIMIT_COOLDOWN_SECONDS=60
SYNC_DEAD_LETTER_MAX_RECORDS_PER_BATCH=20
SYNC_BULK_UPSERT_BATCH_SIZE=1000
SYNC_BULK_UPSERT_MIN_BATCH_SIZE=100
SYNC_BULK_UPSERT_MAX_BATCH_SIZE=1000
SYNC_BULK_UPSERT_SLOW_BATCH_MS=1500
SYNC_BULK_UPSERT_STABLE_BATCHES_TO_GROW=3

# 服务器默认使用保守档：只注册核心市场链路，避免新闻/财务/复盘/板块重任务拖垮 4C8G 机器。
SYNC_PROFILE=conservative
# 可选：SYNC_PROFILE=full 注册全部内置任务；SYNC_ENABLED_JOBS=job1,job2 可白名单启用指定任务。
SYNC_ENABLED_JOBS=
SYNC_DISABLED_JOBS=
SYNC_RUN_INITIAL_SYNC=false
SYNC_MAX_RUNNING_JOBS=1
SYNC_MAX_PARALLEL_COLLECT_CONCURRENCY=2
SYNC_JOB_TIMEOUT_SECONDS=1200
SYNC_LOCK_TIMEOUT_SECONDS=1200
SYNC_SCHEDULER_MISFIRE_GRACE_SECONDS=300
SYNC_PREVENT_INITIAL_HISTORY_SYNC=true
SYNC_INITIAL_BACKFILL_DAYS=5
# 历史补缺/重型任务只允许在闲时窗口运行；也兼容 DATASYNC_BACKFILL_WINDOW_START/END。
SYNC_BACKFILL_WINDOW_START=00:00
SYNC_BACKFILL_WINDOW_END=08:00
SYNC_BACKFILL_QUEUE_SCHEDULE="*/30 * * * *"
SYNC_BACKFILL_JOBS_PER_ROUND=2
SYNC_BACKFILL_MAX_ATTEMPTS=3
SYNC_BACKFILL_MAX_JOBS_PER_NIGHT=24
SYNC_BACKFILL_MAX_EXTERNAL_REQUESTS_PER_NIGHT=300
SYNC_BACKFILL_CONSECUTIVE_FAILURE_LIMIT=3
SYNC_CORE_GAP_RECOVERY_SCHEDULE=
SYNC_RECENT_CORE_GAP_RECOVERY_DAYS=3
SYNC_RUN_CORE_GAP_RECOVERY_ON_STARTUP=true
SYNC_CORE_READY_CHECK_AFTER_LOCAL_TIME=15:30
SYNC_CORE_READY_EXPECTED_AFTER_LOCAL_TIME=16:10
SYNC_CORE_READY_FAIL_AFTER_LOCAL_TIME=17:00
SYNC_CORE_READY_AFTER_LOCAL_TIME=16:10

# 调度覆盖项默认留空，直接使用代码内置时间与快速流水线策略。
SYNC_STOCK_BASIC_SCHEDULE=
SYNC_STOCK_DAILY_SCHEDULE=
SYNC_DAILY_BASIC_SCHEDULE=
SYNC_INDEX_BASIC_SCHEDULE=
SYNC_INDEX_DAILY_SCHEDULE=
SYNC_MONEYFLOW_INDUSTRY_SCHEDULE=
SYNC_MONEYFLOW_CONCEPT_SCHEDULE=
SYNC_LIMIT_LIST_SCHEDULE=
SYNC_STOCK_RELATIONS_SCHEDULE=
SYNC_DAILY_STATS_SCHEDULE=
SYNC_MARKET_STATISTICS_CACHE_SCHEDULE=
SYNC_MARKET_WEATHER_SCHEDULE=
SYNC_MARKET_WEATHER_MAX_CONCURRENT=2
SYNC_REVIEW_DATA_SCHEDULE=
SYNC_FINA_INDICATOR_SCHEDULE=
SYNC_HOT_NEWS_SCHEDULE=
SYNC_THS_SECTOR_SCHEDULE=
SYNC_NEWS_SCHEDULE=
SYNC_MARKET_STATISTICS_CACHE_PERIODS=1w,1m,3m

# 高频/重型非核心任务保护。hot_news 默认关闭，需要时显式启用。
SYNC_REVIEW_DATA_MAX_ROWS_PER_COLLECTION=10000
SYNC_HOT_NEWS_ENABLED=false
SYNC_HOT_NEWS_SOURCE_ALLOWLIST=cls,xueqiu,wallstreetcn
SYNC_HOT_NEWS_MAX_SOURCES_PER_ROUND=3
SYNC_HOT_NEWS_MAX_ITEMS_PER_SOURCE=20
SYNC_HOT_NEWS_MAX_CONCURRENCY=3
SYNC_HOT_NEWS_HTTP_TIMEOUT_SECONDS=10
SYNC_HOT_NEWS_TOTAL_TIMEOUT_SECONDS=30
SYNC_MULTI_SOURCE_NEWS_MAX_CONCURRENCY=2
SYNC_MULTI_SOURCE_NEWS_LIMIT_PER_SOURCE=50
SYNC_EVENT_CLUSTERING_BATCH_SIZE=30
SYNC_EVENT_CLUSTERING_MAX_CONCURRENT=3

NOTIFY_ENABLED=true
NOTIFY_WECOM_WEBHOOK=
NOTIFY_MIN_INTERVAL=10

OBS_LOG_LEVEL=INFO
OBS_LOG_TO_FILE=true
OBS_LOG_DIR=/app/DataSync/logs
OBS_LOG_MAX_SIZE_MB=50
OBS_LOG_BACKUP_COUNT=10
OBS_LOG_SAMPLE_LIMIT=5
OBS_LOG_MAX_VALUE_CHARS=500
OBS_LOKI_ENABLED=false

RPC_DATA_SYNC_PORT=50054
RPC_TIMEOUT=10.0
RPC_MAX_RETRIES=3
